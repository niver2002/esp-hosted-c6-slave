# ============================================================
# ESP-Hosted Slave Common Configuration (ESP-IDF v6.1)
# ============================================================

# 1. BT Configuration (禁用以节省资源)
#--------------------------------------
CONFIG_BT_ENABLED=n
# CONFIG_BT_CONTROLLER_ONLY=y

# 2. OTA Configuration
#---------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# 3. OS Configuration
#--------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

# ESP-Hosted task priority (提高到23，确保WiFi发送优先)
CONFIG_ESP_HOSTED_DEFAULT_TASK_PRIORITY=23

# 4. Bootloader Optimization
#----------------------------
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
# Use Log V2 for bootloader (ESP-IDF v6.1)
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# 5. WiFi Configuration
#----------------------
# Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# 6. Compiler Optimization
#--------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# 7. Log Configuration (ESP-IDF v6.1)
#-------------------------------------
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
