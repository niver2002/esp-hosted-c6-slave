# BT Configuration (禁用以节省资源)
CONFIG_BT_ENABLED=n
# CONFIG_BT_CONTROLLER_ONLY=y

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y

#Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# ============================================================
# SDIO Performance Configuration
# ============================================================
CONFIG_ESP_SDIO_TX_Q_SIZE=40
CONFIG_ESP_SDIO_RX_Q_SIZE=40

# ============================================================
# WiFi Buffer Configuration (increased for throughput)
# ============================================================
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
